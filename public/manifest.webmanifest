{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Jisho Slide",
  "short_name": "Jisho Slide",
  "description": "Minimal JLPT Japanese word slideshow",
  "start_url": "/jisho-slide/",
  "scope": "/jisho-slide/",
  "display": "standalone",
  "background_color": "#1B2028",
  "theme_color": "#23a9d5",
  "orientation": "portrait",
  "icons": [
    {
      "src": "pwa-64x64.png",
      "sizes": "64x64",
      "type": "image/png"
    },
    {
      "src": "pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "maskable-icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
